{
  "apiVersion": "takosumi.com/v1",
  "kind": "Repository",
  "install": {
    "modules": {
      ".": {
        "inputs": [
          {
            "name": "project_name",
            "source": {
              "kind": "capsule_name"
            },
            "role": "service_name",
            "type": "string",
            "format": "subdomain",
            "label": {
              "ja": "サービス名",
              "en": "Service name"
            },
            "helper": {
              "ja": "ワークスペース内で使うYurumeetの名前です。",
              "en": "The name of this Yurumeet service in the workspace."
            },
            "advanced": true
          },
          {
            "name": "app_url",
            "source": {
              "kind": "user"
            },
            "type": "string",
            "format": "url",
            "required": false,
            "label": {
              "ja": "公開URL",
              "en": "Public URL"
            },
            "helper": {
              "ja": "空欄の場合は利用可能なWorker URLを使います。",
              "en": "Uses an available Worker URL when omitted."
            },
            "placeholder": "https://meet.example.com"
          },
          {
            "name": "takosumi_accounts_issuer_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "Takosumi Accounts発行者",
              "en": "Takosumi Accounts issuer"
            },
            "advanced": true
          },
          {
            "name": "takosumi_accounts_client_id",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "Takosumi Accountsクライアント",
              "en": "Takosumi Accounts client"
            },
            "advanced": true
          },
          {
            "name": "auth_password_hash",
            "source": {
              "kind": "user"
            },
            "role": "initial_secret",
            "type": "string",
            "format": "password",
            "required": false,
            "label": {
              "ja": "初期パスワード",
              "en": "Initial password"
            },
            "helper": {
              "ja": "パスワード認証を選んだ場合だけ入力します。",
              "en": "Enter this only when password authentication is selected."
            },
            "secret": true
          },
          {
            "name": "worker_release_tag",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリース",
              "en": "Release"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_url",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "format": "url",
            "label": {
              "ja": "リリースURL",
              "en": "Release URL"
            },
            "advanced": true
          },
          {
            "name": "worker_bundle_sha256",
            "source": {
              "kind": "module_default"
            },
            "type": "string",
            "label": {
              "ja": "リリースSHA-256",
              "en": "Release SHA-256"
            },
            "advanced": true
          }
        ],
        "requires": [
          {
            "kind": "http.endpoint",
            "deliver": {
              "variables": {
                "url": "app_url",
                "subdomain": "project_name"
              }
            }
          },
          {
            "kind": "identity.oidc",
            "callbackPath": "/api/auth/callback/takos",
            "scopes": [
              "openid",
              "profile",
              "email"
            ],
            "deliver": {
              "variables": {
                "issuerUrl": "takosumi_accounts_issuer_url",
                "clientId": "takosumi_accounts_client_id"
              }
            }
          }
        ],
        "features": [
          {
            "id": "password-authentication",
            "optional": true,
            "label": {
              "ja": "パスワードでログイン",
              "en": "Sign in with a password"
            },
            "inputs": [
              "auth_password_hash"
            ]
          }
        ]
      }
    }
  }
}
